# Misc
.cache/
.turbo/
# tsc incremental cache. NOTE: the pattern must be `*.tsbuildinfo` — a bare
# `.tsbuildinfo` matches only a file literally named that, so the real
# `tsconfig.tsbuildinfo` files stayed tracked and dirtied `git status` on every build.
*.tsbuildinfo

.env

apps/desktop/release/

# Pulse-to-ACE migration: CSVs of users contain SIP passwords. Never commit.
pulse_users.csv
pulse_users*.csv
*.users.csv

# Local Claude Code settings — per-developer, not shared
.claude/settings.local.json


# Backfill manifests (contain media URLs)
scripts/out/
