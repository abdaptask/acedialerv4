{
  "manifest_version": 3,
  "name": "ACE Dialer",
  "version": "0.10.242",
  "description": "Makes phone numbers on your ATS and CRM clickable, and shows the missed calls, texts and voicemails still waiting on you.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "identity",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://dialer.aptask.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dialer.aptask.com/*"
      ],
      "js": [
        "dialerBridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "ACE Dialer"
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}
